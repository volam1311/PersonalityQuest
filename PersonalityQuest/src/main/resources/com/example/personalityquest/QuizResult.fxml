<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="quizResultRoot" styleClass="dashboard-root" stylesheets="@css/dashboard.css, @css/quest.css, @css/tasks.css, @css/quiz.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.personalityquest.Controllers.QuizResultController">
    <left>
        <fx:include fx:id="navBar" source="NavBar.fxml" />
    </left>

    <center>
        <ScrollPane fx:id="contentScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll" vbarPolicy="AS_NEEDED">
            <content>
                <VBox fx:id="contentContainer" spacing="18" styleClass="content-container">
                    <padding>
                        <Insets bottom="24" left="24" right="24" top="24" />
                    </padding>

                    <VBox spacing="6">
                        <Label styleClass="page-title" text="Your Archetype" />
                        <Label styleClass="page-subtitle" text="This is the pattern that showed up most strongly in your answers." />
                    </VBox>

                    <VBox spacing="16" styleClass="card quiz-card">
                        <Label styleClass="section-label" text="You are" />
                        <Label fx:id="archetypeNameLabel" styleClass="quiz-result-name" wrapText="true" text="The Explorer" />
                        <Label fx:id="archetypeDescriptionLabel" styleClass="lore-body" wrapText="true" text="" />
                        <Label styleClass="section-label" text="Strengths" />
                        <Label fx:id="strengthsLabel" styleClass="lore-body" wrapText="true" text="" />
                        <Label styleClass="section-label" text="Watch-outs" />
                        <Label fx:id="weaknessesLabel" styleClass="lore-body" wrapText="true" text="" />
                        <Label fx:id="questLabel" styleClass="quest-meta" wrapText="true" text="" />
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Button mnemonicParsing="false" onAction="#OnRetake" styleClass="draft-button" text="Retake quiz" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button mnemonicParsing="false" onAction="#OnBeginQuest" styleClass="pill-button" text="Begin your quest" />
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
