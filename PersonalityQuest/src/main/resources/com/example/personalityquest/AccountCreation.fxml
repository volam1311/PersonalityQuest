<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.personalityquest.AccountCreationController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Email"/>
    <TextField fx:id="emailEntry"/>

    <Label text="Username"/>
    <TextField fx:id="userNameEntry"/>

    <Label text="First Name"/>
    <TextField fx:id="firstNameEntry"/>

    <Label text="Last Name"/>
    <TextField fx:id="lastNameEntry"/>

    <Label text="Password"/>
    <TextField fx:id="passwordEntry"/>

    <Label text="Re-Enter Password"/>
    <TextField fx:id="reEnterPasswordEntry"/>

    <Button text="Sign Up" onAction="#OnSignUp"/>
</VBox>
