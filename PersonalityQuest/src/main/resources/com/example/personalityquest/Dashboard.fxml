<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane fx:id="dashboardRoot" styleClass="dashboard-root" stylesheets="@css/dashboard.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.personalityquest.Controllers.navigation.DashboardController">
    <left>
        <fx:include fx:id="navBar" source="NavBar.fxml" />
    </left>

    <center>
        <ScrollPane fx:id="contentScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll" vbarPolicy="AS_NEEDED">
            <content>
                <VBox fx:id="contentContainer" spacing="18" styleClass="content-container">
                    <padding>
                        <Insets bottom="24" left="24" right="24" top="24" />
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="16" styleClass="dashboard-header">
                        <Label fx:id="welcomeMessage" styleClass="welcome-label" text="Welcome back, Leon!" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox styleClass="streak-badge" spacing="8">
                            <SVGPath styleClass="material-symbol streak-icon" style="-fx-fill: #ffffff;" content="M13.5 .67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.03 0-3.58-1.64-3.58-3.67l.03-.43C5.21 7.48 3 10.2 3 13.5 3 18.19 6.81 22 11.5 22S20 18.19 20 13.5c0-5.06-3.41-9.31-6.5-12.83zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.72 1.11-2.99 2.94-4.1-.02.11-.03.23-.03.35 0 .98.79 1.78 1.77 1.78 1.01 0 1.75-.82 1.75-1.83 0-.39-.08-.8-.08-.8 1.78 1.7 2.87 3.48 2.87 4.84 0 1.6-1.34 2.9-3 2.9z" />
                            <Label fx:id="streakLabel" styleClass="streak-text" text="Day 0" />
                        </HBox>
                    </HBox>

                    <GridPane fx:id="topGrid" hgap="12" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="65" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="35" />
                        </columnConstraints>

                        <VBox fx:id="questCard" spacing="12" styleClass="card quest-card" GridPane.columnIndex="0">
                            <Label fx:id="questTitleLabel" styleClass="card-title" text="The Hydra Questline" />
                            <Label styleClass="quest-divider" text="━━━━━━━━━━━━━━━━━━━━" />
                            <Label styleClass="quest-divider" text="━━━━━━━━━━━━━━━━━━━━" />
                            <Region VBox.vgrow="ALWAYS" />
                            <Label fx:id="questDescriptionLabel" styleClass="quest-description" text="Complete the storyline quest tasks to continue the labour" wrapText="true" />
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <ProgressBar fx:id="questProgress" maxWidth="1.7976931348623157E308" progress="0.2" HBox.hgrow="ALWAYS" />
                                <Label fx:id="questProgressLabel" styleClass="progress-label" text="20% Complete" />
                            </HBox>
                        </VBox>

                        <VBox fx:id="dailiesCard" spacing="10" styleClass="card" GridPane.columnIndex="1">
                            <Label id="dailiesTitle" styleClass="card-title centered-title" text="Weekly Tasks" />
                            <ListView fx:id="weeklyTasks" focusTraversable="false" onMouseClicked="#OnWeeklyTaskClick" prefHeight="230" styleClass="task-list" VBox.vgrow="ALWAYS" />
                        </VBox>
                    </GridPane>

                    <GridPane fx:id="lowerGrid" hgap="12" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="36" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="64" />
                        </columnConstraints>

                        <VBox fx:id="tasksCard" spacing="10" styleClass="card" GridPane.columnIndex="0">
                            <Label id="tasksTitle" styleClass="card-title centered-title" text="Quest Tasks" />
                            <ListView fx:id="questTasks" focusTraversable="false" onMouseClicked="#OnQuestTaskClick" prefHeight="270" styleClass="task-list" VBox.vgrow="ALWAYS" />
                        </VBox>

                        <VBox fx:id="progressCard" alignment="TOP_CENTER" spacing="6" styleClass="card" GridPane.columnIndex="1">
                            <Label id="progressTitle" styleClass="card-title centered-title" text="Your Progress" />
                            <Canvas fx:id="progressChart" height="260" width="420" />
                        </VBox>
                    </GridPane>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
