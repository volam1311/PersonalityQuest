<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="10" style="-fx-background-color: lightblue;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.personalityquest.Controllers.DashboardController">
    <HBox spacing="20.0">
        <fx:include source="NavBar.fxml" />
        <VBox alignment="TOP_CENTER" prefHeight="480" prefWidth="500.0" spacing="10" VBox.vgrow="ALWAYS">
            <Label fx:id="welcomeMessage" style="-fx-font-weight: bold;" text="Dashboard" textAlignment="LEFT">
                <font>
                    <Font size="24.0" />
                </font></Label>
         <HBox alignment="BOTTOM_CENTER" prefHeight="100.0" prefWidth="200.0">
            <children>
               <VBox alignment="TOP_CENTER" prefHeight="300.0" prefWidth="520.0" spacing="10">
                  <children>
                     <Label alignment="CENTER" text="Weekly Tasks" textAlignment="CENTER">
                        <font>
                           <Font name="System Bold" size="18.0" />
                        </font>
                     </Label>
                     <ListView fx:id="weeklyTasks" onMouseClicked="#OnTaskClick" prefHeight="200.0" prefWidth="200.0" />
                  </children>
               </VBox>
               <VBox alignment="TOP_CENTER" prefHeight="300.0" prefWidth="520.0" spacing="10">
                  <children>
                     <Label alignment="CENTER" text="Progress Graph" textAlignment="CENTER">
                        <font>
                           <Font name="System Bold" size="18.0" />
                        </font>
                     </Label>
                  </children>
               </VBox>
            </children>
         </HBox>
        </VBox>
    </HBox>

</VBox>
