<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane fx:id="dashboardRoot" styleClass="dashboard-root" stylesheets="@css/dashboard.css, @css/quest.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.personalityquest.Controllers.navigation.DashboardController">
    <left>
        <fx:include fx:id="navBar" source="NavBar.fxml" />
    </left>

    <center>
        <ScrollPane fx:id="contentScroll" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="content-scroll" vbarPolicy="AS_NEEDED">
            <content>
                <VBox fx:id="contentContainer" spacing="18" styleClass="content-container">
                    <padding>
                        <Insets bottom="24" left="24" right="24" top="24" />
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="16" styleClass="dashboard-header">
                        <Label fx:id="welcomeMessage" styleClass="welcome-label" text="Welcome back, Leon!" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox styleClass="streak-badge" spacing="8">
                            <SVGPath styleClass="material-symbol streak-icon" style="-fx-fill: #ffffff;" content="M13.5 .67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.03 0-3.58-1.64-3.58-3.67l.03-.43C5.21 7.48 3 10.2 3 13.5 3 18.19 6.81 22 11.5 22S20 18.19 20 13.5c0-5.06-3.41-9.31-6.5-12.83zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.72 1.11-2.99 2.94-4.1-.02.11-.03.23-.03.35 0 .98.79 1.78 1.77 1.78 1.01 0 1.75-.82 1.75-1.83 0-.39-.08-.8-.08-.8 1.78 1.7 2.87 3.48 2.87 4.84 0 1.6-1.34 2.9-3 2.9z" />
                            <Label fx:id="streakLabel" styleClass="streak-text" text="Week 0" />
                        </HBox>
                    </HBox>

                    <!-- Placeholder 2x3 home layout: boxes reused directly from the Profile and Quest screens -->
                    <GridPane fx:id="homeGrid" hgap="12" vgap="12" VBox.vgrow="ALWAYS" maxHeight="Infinity" maxWidth="Infinity" minHeight="0" minWidth="0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.34" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints percentHeight="50" vgrow="ALWAYS" />
                            <RowConstraints percentHeight="50" vgrow="ALWAYS" />
                        </rowConstraints>

                        <!-- Row 1, Col 1: Archetype Balance (copied from Profile.fxml progressCard) -->
                        <VBox fx:id="progressCard" alignment="TOP_CENTER" spacing="6" styleClass="card" minWidth="0" minHeight="0"
                              GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label id="progressTitle" styleClass="card-title centered-title" text="Archetype Balance" />
                            <Canvas fx:id="progressChart" height="280" width="480" />
                        </VBox>

                        <!-- Row 1, Col 2: Why this labour (copied from Quest.fxml traitCard) -->
                        <VBox fx:id="traitCard" spacing="10" styleClass="card" minWidth="0" minHeight="0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label styleClass="card-title" text="Why this labour" />
                            <Label styleClass="section-label" text="Trait focus" />
                            <Label fx:id="traitLabel" styleClass="lore-body" wrapText="true" text="—" />
                            <Label styleClass="section-label" text="Reflection" />
                            <Label fx:id="reflectionPromptLabel" styleClass="lore-body" wrapText="true" text="—" />
                        </VBox>

                        <!-- Row 1 and 2, Col 3: Three thermometers (vertical progress bars) -->
                        <VBox fx:id="verticalProgressCard" alignment="CENTER" spacing="10" styleClass="card" minWidth="0" minHeight="0"
                              GridPane.columnIndex="2" GridPane.rowIndex="0" GridPane.rowSpan="2">
                            <Label styleClass="card-title centered-title" text="Progress" />
                            <HBox fx:id="thermometerRow" alignment="CENTER" spacing="12" VBox.vgrow="ALWAYS" minHeight="0">
                                <VBox alignment="CENTER" spacing="10" fillWidth="false" HBox.hgrow="ALWAYS" minHeight="0">
                                    <Label styleClass="progress-label" text="Challenges" />
                                    <Region VBox.vgrow="ALWAYS" />
                                    <ProgressBar fx:id="challengesProgress" progress="0" prefWidth="260" rotate="-90" />
                                    <Region VBox.vgrow="ALWAYS" />
                                </VBox>
                                <VBox alignment="CENTER" spacing="10" fillWidth="false" HBox.hgrow="ALWAYS" minHeight="0">
                                    <Label styleClass="progress-label" text="Reflections" />
                                    <Region VBox.vgrow="ALWAYS" />
                                    <ProgressBar fx:id="reflectionsProgress" progress="0" prefWidth="260" rotate="-90" />
                                    <Region VBox.vgrow="ALWAYS" />
                                </VBox>
                                <VBox alignment="CENTER" spacing="10" fillWidth="false" HBox.hgrow="ALWAYS" minHeight="0">
                                    <Label styleClass="progress-label" text="Weeklys" />
                                    <Region VBox.vgrow="ALWAYS" />
                                    <ProgressBar fx:id="weeklyProgress" progress="0" prefWidth="260" rotate="-90" />
                                    <Region VBox.vgrow="ALWAYS" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Row 2, Col 1: Your quests (copied from Quest.fxml historyCard) -->
                        <VBox fx:id="historyCard" spacing="10" styleClass="card" minWidth="0" minHeight="0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label styleClass="card-title" text="Your quests" />
                            <Label styleClass="page-subtitle" text="Select a quest to read its story." />
                            <ListView fx:id="questHistory" focusTraversable="false" prefHeight="280" styleClass="task-list" VBox.vgrow="ALWAYS" />
                        </VBox>

                        <!-- Row 2, Col 2: This week's challenge (copied from Quest.fxml challengeCard) -->
                        <VBox fx:id="challengeCard" spacing="10" styleClass="card" minWidth="0" minHeight="0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label styleClass="card-title" text="This week's challenge" />
                            <Label fx:id="challengeLabel" styleClass="lore-body" wrapText="true" text="Your challenge will appear here once a quest is active." />
                        </VBox>
                    </GridPane>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
