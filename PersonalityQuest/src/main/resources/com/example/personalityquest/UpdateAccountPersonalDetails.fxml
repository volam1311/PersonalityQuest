<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10" style="-fx-background-color: lightblue;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="com.example.personalityquest.Controllers.auth.UpdateAccountPersonalDetailsController">

    <padding>
        <Insets left="20.0" right="20.0" />
    </padding>

    <HBox alignment="CENTER_RIGHT">
        <padding>
            <Insets right="20.0" />
        </padding>
        <Label style="-fx-font-weight: bold;" text="Email" />
    </HBox>
    <TextField fx:id="emailEntry" />

    <HBox alignment="CENTER_RIGHT">
        <padding>
            <Insets right="20.0" />
        </padding>
        <Label style="-fx-font-weight: bold;" text="UserName" />
    </HBox>
    <TextField fx:id="userNameEntry" />

    <HBox alignment="CENTER_RIGHT">
        <padding>
            <Insets right="20.0" />
        </padding>
        <Label style="-fx-font-weight: bold;" text="FirstName" />
    </HBox>
    <TextField fx:id="firstNameEntry" />

    <HBox alignment="CENTER_RIGHT">
        <padding>
            <Insets right="20.0" />
        </padding>
        <Label style="-fx-font-weight: bold;" text="LastName" />
    </HBox>
    <TextField fx:id="lastNameEntry" />

    <VBox alignment="CENTER" spacing="20" xmlns:fx="http://javafx.com/fxml">
        <Label style="-fx-font-weight: bold;" fx:id="Message"/>
        <Button onAction="#OnSaveAndExit" style="-fx-font-weight: bold;" text="Save And Exit" />
        <Button onAction="#OnExit" style="-fx-font-weight: bold;" text="Exit" />
    </VBox>
</VBox>
