<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10" style="-fx-background-color: lightblue;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.personalityquest.Controllers.AccountSignInController">

    <padding>
        <Insets left="20.0" right="20.0" />
    </padding>

    <HBox alignment="CENTER_RIGHT">
        <padding>
            <Insets right="20.0" />
        </padding>
        <Label style="-fx-font-weight: bold;" text="Email" />
    </HBox>
    <TextField fx:id="emailEntry" />

    <HBox alignment="CENTER_RIGHT">
        <padding>
            <Insets right="20.0" />
        </padding>
        <Label style="-fx-font-weight: bold;" text="Password" />
    </HBox>
    <TextField fx:id="passwordEntry" />

    <VBox alignment="CENTER" spacing="20" xmlns:fx="http://javafx.com/fxml">
        <Label style="-fx-font-weight: bold;" fx:id="Message"/>
        <Button onAction="#OnSignIn" style="-fx-font-weight: bold;" text="Sign In" />
        <Label onMouseClicked="#OnSignUp" text="Or Click Here to Sign Up" underline="true" />

    </VBox>
</VBox>
